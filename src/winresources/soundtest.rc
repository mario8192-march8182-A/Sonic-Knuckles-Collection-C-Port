#include <windows.h>
#include "..\winresource.h"

IDD_SOUNDTEST_EN DIALOG 0, 0, 247, 52
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sound Test"
FONT 8, "MS Sans Serif"
BEGIN
  CONTROL "S.E.", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 14, 24, 8 
  CONTROL "No.01", ID_SOUNDTEST_SE_NO, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 40, 14, 36, 8 
  CONTROL "", ID_SOUNDTEST_SE_UPDOWN, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 80, 11, 24, 14 
  CONTROL "Play", ID_SOUNDTEST_SE_PLAY, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 112, 11, 36, 14 
  CONTROL "B.G.M.", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 31, 24, 8 
  CONTROL "No.01", ID_SOUNDTEST_BGM_NO, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 40, 31, 36, 8 
  CONTROL "", ID_SOUNDTEST_BGM_UPDOWN, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 80, 31, 24, 14 
  CONTROL "Play", ID_SOUNDTEST_BGM_PLAY, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 112, 31, 36, 14 
  CONTROL "Stop", ID_SOUNDTEST_BGM_STOP, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 154, 31, 36, 14 
  CONTROL "OK", ID_SOUNDTEST_OK, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 190, 7, 50, 14 
END

