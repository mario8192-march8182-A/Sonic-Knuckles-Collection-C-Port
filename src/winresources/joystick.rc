#include <windows.h>
#include "..\winresource.h"

IDD_JOYSTICK_EN DIALOG 0, 0, 191, 53
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Joystick"
FONT 8, "MS Sans Serif"
BEGIN
  CONTROL "&1P:", -1, STATIC, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 14, 24, 8 
  CONTROL "", ID_JOYSTICK_P1, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 40, 12, 80, 30 
  CONTROL "&2P:", -1, STATIC, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 34, 24, 8 
  CONTROL "", ID_JOYSTICK_P2, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 40, 32, 80, 30 
  CONTROL "OK", ID_JOYSTICK_OK, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 134, 7, 50, 14 
  CONTROL "Cancel", ID_JOYSTICK_CANCEL, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 134, 24, 50, 14 
END

