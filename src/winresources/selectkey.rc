#include <windows.h>
#include "..\winresource.h"

IDD_SELECTKEY_EN DIALOG 0, 0, 145, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Key"
FONT 8, "MS Sans Serif"
BEGIN
  CONTROL "OK", ID_SELECTKEY_OK, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 88, 7, 50, 14 
  CONTROL "Cancel", ID_SELECTKEY_CANCEL, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 88, 24, 50, 14 
  CONTROL "&Key:", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 7, 60, 8 
  CONTROL "", ID_SELECTKEY_LIST, LISTBOX, LBS_NOTIFY | LBS_DISABLENOSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 7, 21, 72, 64 
END

